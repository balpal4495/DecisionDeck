# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_PATH=./local.db

# ── Dashboard thresholds ───────────────────────────────────────────────────────
# PRs open longer than this many days are flagged as medium risk
PR_AGE_WARNING_DAYS=7

# ── GitHub Integration (Phase 1) ───────────────────────────────────────────────
# For GitHub Enterprise, set GH_HOST to your enterprise hostname.
# For github.com, leave GH_HOST blank or omit it.
GH_HOST=
# Personal access token with `repo` scope (read-only is sufficient)
GH_TOKEN=
# Comma-separated list of repositories to sync, e.g. myorg/platform,myorg/billing
GH_REPOS=

# ── Jira Integration (Phase 2) ────────────────────────────────────────────────
JIRA_HOST=https://yourorg.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_TOKEN=
# Comma-separated Jira project keys, e.g. PLAT,BILL
JIRA_PROJECTS=

# ── Confluence Integration (Phase 3) ─────────────────────────────────────────
CONFLUENCE_HOST=https://yourorg.atlassian.net
CONFLUENCE_EMAIL=your@email.com
CONFLUENCE_TOKEN=
# Comma-separated Confluence space keys, e.g. ARCH,ENG
CONFLUENCE_SPACES=
